# Nicolla Contractors — env manifest. NO REAL VALUES HERE.
# Dev: copy to .env.local.  Prod/Preview: set in the Vercel dashboard.

# Customer review store (Upstash Redis) — SERVER-ONLY (optional in dev).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
