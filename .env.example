# Nicolla Contractors — env manifest. NO REAL VALUES HERE.
# Dev: copy to .env.local.  Prod/Preview: set in the Vercel dashboard.

# Customer review store (Upstash Redis) — SERVER-ONLY (optional in dev).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# Lead email delivery (Resend SDK) — SERVER-ONLY (required for lead capture).
#   RESEND_API_KEY   secret from resend.com → API Keys
#   LEAD_TO_EMAIL    inbox that receives enquiries
#   LEAD_FROM_EMAIL  sender on the VERIFIED domain (or onboarding@resend.dev to test)
RESEND_API_KEY=
LEAD_TO_EMAIL=info@nicollacontractors.co.uk
LEAD_FROM_EMAIL=Nicolla Contractors <leads@nicollacontractors.co.uk>
# Dev only: compose the email but DON'T send (no key/DNS needed). Never set in prod.
# LEAD_DRY_RUN=1

# Google Analytics measurement ID — PUBLIC by design.
NEXT_PUBLIC_GA_ID=
