# Lead delivery (src/app/api/lead/route.ts)
#
# 1. Create a free account at https://resend.com
# 2. Verify the sending domain (nicollacontractors.co.uk) under Domains,
#    or use onboarding@resend.dev as LEAD_FROM_EMAIL while testing
#    (resend.dev senders can only deliver to your own Resend account email).
# 3. Create an API key and copy these three lines into .env.local:

RESEND_API_KEY=
LEAD_TO_EMAIL=info@nicollacontractors.co.uk
LEAD_FROM_EMAIL=Nicolla Website <leads@nicollacontractors.co.uk>

# Test-only override of the Resend endpoint (leave unset in production):
# RESEND_API_URL=
